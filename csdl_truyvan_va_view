//1.hien thi danh sach bac si va ten khoa
SELECT 
    BS.MaBS,
    BS.HoTen,
    BS.GioiTinh,
    BS.SDT,
    K.TenKhoa
FROM BacSi BS
JOIN Khoa K ON BS.MaKhoa = K.MaKhoa;

//2.hien thi lich kham cua benh nhan
SELECT 
    LK.MaLK,
    BN.HoTen AS TenBenhNhan,
    BS.HoTen AS TenBacSi,
    LK.ThoiGianKham,
    LK.LyDo,
    LK.TrangThai
FROM LichKham LK
JOIN BenhNhan BN ON LK.MaBN = BN.MaBN
JOIN BacSi BS ON LK.MaBS = BS.MaBS;

//3.tim cac lich kham dang cho kham
SELECT *
FROM LichKham
WHERE TrangThai = N'Chờ khám'
ORDER BY ThoiGianKham ASC;

//4.tim benh nhan da kham trong mot khoang thoi gian
SELECT DISTINCT
    BN.MaBN,
    BN.HoTen,
    BN.NgaySinh,
    BN.SDT
FROM BenhNhan BN
JOIN LichKham LK ON BN.MaBN = LK.MaBN
WHERE LK.TrangThai = N'Đã khám'
  AND LK.ThoiGianKham >= '20260101'
  AND LK.ThoiGianKham < '20270101';

//5.dem so bac si cua tung khoa
SELECT 
    K.MaKhoa,
    K.TenKhoa,
    COUNT(BS.MaBS) AS SoLuongBacSi
FROM Khoa K
LEFT JOIN BacSi BS ON K.MaKhoa = BS.MaKhoa
GROUP BY K.MaKhoa, K.TenKhoa;

//6.tim cac khoa co 3 bac si tro len
SELECT 
    K.MaKhoa,
    K.TenKhoa,
    COUNT(BS.MaBS) AS SoLuongBacSi
FROM Khoa K
JOIN BacSi BS ON K.MaKhoa = BS.MaKhoa
GROUP BY K.MaKhoa, K.TenKhoa
HAVING COUNT(BS.MaBS) >= 3;

//7.thong ke so lich kham cua tung bac si
SELECT 
    BS.MaBS,
    BS.HoTen,
    COUNT(LK.MaLK) AS SoLichKham
FROM BacSi BS
LEFT JOIN LichKham LK ON BS.MaBS = LK.MaBS
GROUP BY BS.MaBS, BS.HoTen
ORDER BY SoLichKham DESC;

//8.tim cac thuoc co gia ban cao hon gia trung binh tat ca thuoc
SELECT 
    MaThuoc,
    TenThuoc,
    DonVi,
    DonGia,
    SoLuongTon
FROM Thuoc
WHERE DonGia > (
    SELECT AVG(DonGia)
    FROM Thuoc
    WHERE DonGia IS NOT NULL
);

//9.thong ke tong tien thuoc theo tung don thuoc
SELECT 
    DT.MaDT,
    DT.NgayKe,
    SUM(CT.SoLuong * CT.DonGiaKe) AS TongTienThuoc
FROM DonThuoc DT
JOIN ChiTietDonThuoc CT ON DT.MaDT = CT.MaDT
GROUP BY DT.MaDT, DT.NgayKe;

//10.thong ke doanh thu hoa don da thanh toan theo thang
SELECT 
    YEAR(NgayLap) AS Nam,
    MONTH(NgayLap) AS Thang,
    COUNT(MaHD) AS SoHoaDon,
    SUM(TongTien) AS TongDoanhThu
FROM HoaDon
WHERE TrangThai = N'Đã thanh toán'
GROUP BY YEAR(NgayLap), MONTH(NgayLap)
ORDER BY Nam DESC, Thang DESC;

//view1 danh sach lich kham chi tiet
CREATE VIEW vw_DanhSachLichKham
AS
SELECT 
    LK.MaLK,
    BN.MaBN,
    BN.HoTen AS TenBenhNhan,
    BS.MaBS,
    BS.HoTen AS TenBacSi,
    K.TenKhoa,
    LK.ThoiGianKham,
    LK.LyDo,
    LK.TrangThai
FROM LichKham LK
JOIN BenhNhan BN ON LK.MaBN = BN.MaBN
JOIN BacSi BS ON LK.MaBS = BS.MaBS
JOIN Khoa K ON BS.MaKhoa = K.MaKhoa;
GO

SELECT *
FROM vw_DanhSachLichKham;

SELECT *
FROM vw_DanhSachLichKham
WHERE TrangThai = N'Chờ khám';

//view2 thong ke hoa don theo benh nhan
CREATE VIEW vw_ThongKeHoaDonBenhNhan
AS
SELECT 
    BN.MaBN,
    BN.HoTen AS TenBenhNhan,
    BA.MaBA,
    HD.MaHD,
    HD.NgayLap,
    HD.TongTien,
    HD.TrangThai
FROM BenhNhan BN
LEFT JOIN LichKham LK ON BN.MaBN = LK.MaBN
LEFT JOIN HoSoBenhAn BA ON LK.MaLK = BA.MaLK
LEFT JOIN HoaDon HD ON BA.MaBA = HD.MaBA;
GO

SELECT *
FROM vw_ThongKeHoaDonBenhNhan;

SELECT *
FROM vw_ThongKeHoaDonBenhNhan
WHERE TrangThai = N'Chưa thanh toán';


